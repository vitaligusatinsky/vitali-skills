#!/usr/bin/env python3
"""docgate: the one sanctioned way to turn an HTML document into a deliverable PDF.

    docgate render <in.html> <out.pdf> [--profile a4-report] [--tiles DIR] [--pages 10-12] [--bands]
    docgate check  <out.pdf>                 # does the receipt match this exact PDF?
    docgate sheet  <pdf-or-dir> --out x.png  # contact sheet: N pages per image an LLM can read
    docgate quality <pdf> [--pages 10-12] [--explain]   # which lines and gaps cause each finding
    docgate test   [--manifest FILE ...]     # fixtures: rejected versions fail on their own
                                             # defect classes, approved versions pass
    docgate pair   <a.pdf> <b.pdf> <outdir>  # matched page pairs, side by side (golden compare)

`render` prints with a pinned Chromium (Playwright), runs DOM preflight checks, then checks the
real PDF (page sizes, fonts, how far down each page the ink reaches, an orphaned last page),
writes 150 dpi page images for self-review and the critic (three band tiles per page only
with --bands), and writes a receipt `<out.pdf>.docgate.json` bound to the PDF's sha256.
`--pages` runs the page-level rules and images on those pages only, for iteration: the
receipt is marked partial and can never pass. Exit 0 = pass, 1 = blocking findings,
2 = could not run.

Waivers are config lines in the HTML, each with a reason, and are recorded in the receipt:
    <meta name="docgate-waive" content="fill: page 3 ends a chapter on purpose">
Expected font families can be declared per document (default from the profile):
    <meta name="docgate-fonts" content="Landour, Nohemi">

Rules, levels and calibration: SKILL.md and ~/.claude/rules-library/document-design.md.
"""
import argparse
import contextlib
import datetime as dt
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time
from pathlib import Path

VERSION = "0.1.0"
PINNED_PLAYWRIGHT = "1.58.0"  # Chromium 145 (rev 1208). Bump deliberately, then re-run `docgate test`.
HERE = Path(__file__).resolve().parent.parent  # the skill folder
PROFILES = HERE / "profiles"
PREFLIGHT_JS = HERE / "lib" / "preflight.js"
DEFAULT_MANIFEST = HERE / "fixtures" / "manifest.json"
DPI = 150
MM = 72 / 25.4  # pt per mm


# ----------------------------------------------------------------------------- helpers
def sha256(path):
    h = hashlib.sha256()
    with open(path, "rb") as fh:
        for chunk in iter(lambda: fh.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def run(cmd):
    p = subprocess.run(cmd, capture_output=True, text=True)
    return p.returncode, p.stdout, p.stderr


def parse_pages(spec, total=None):
    """'3', '10-12', '1,4,8-9' -> sorted page numbers; '-N' style open ends are not supported."""
    out = set()
    for part in str(spec).split(","):
        part = part.strip()
        if not part:
            continue
        m = re.fullmatch(r"(\d+)(?:\s*-\s*(\d+))?", part)
        if not m:
            raise SystemExit(f"docgate: bad --pages {spec!r}: use 3, 10-12 or 1,4,8-9")
        a = int(m.group(1))
        b = int(m.group(2) or a)
        if b < a:
            raise SystemExit(f"docgate: bad --pages range {part}")
        out.update(range(a, b + 1))
    if total is not None:
        bad = sorted(n for n in out if n < 1 or n > total)
        if bad:
            raise SystemExit(f"docgate: --pages {spec}: the PDF has {total} pages, no page {bad[0]}")
    if not out:
        raise SystemExit("docgate: --pages is empty")
    return sorted(out)


def fmt_pages(pages):
    """[10, 11, 12, 15] -> '10-12,15'."""
    out, i = [], 0
    while i < len(pages):
        j = i
        while j + 1 < len(pages) and pages[j + 1] == pages[j] + 1:
            j += 1
        out.append(str(pages[i]) if i == j else f"{pages[i]}-{pages[j]}")
        i = j + 1
    return ",".join(out)


@contextlib.contextmanager
def stage(timings, name):
    t = time.perf_counter()
    try:
        yield
    finally:
        timings[name] = round(time.perf_counter() - t, 2)


def load_profile(name):
    path = Path(name) if name.endswith(".json") else PROFILES / f"{name}.json"
    if not path.is_file():
        raise SystemExit(f"docgate: no profile {name} (looked in {PROFILES})")
    return json.loads(path.read_text())


def tool_versions():
    v = {"docgate": VERSION}
    try:
        import importlib.metadata as md
        v["playwright"] = md.version("playwright")
    except Exception:
        v["playwright"] = None
    for tool in ("pdfinfo", "pdffonts", "pdftoppm"):
        code, out, err = run([tool, "-v"]) if shutil.which(tool) else (1, "", "")
        m = re.search(r"version ([\d.]+)", out + err)
        v[tool] = m.group(1) if m else None
    return v


def meta_values(html, name):
    vals = []
    for m in re.finditer(r"<meta\s+[^>]*>", html, re.I):
        tag = m.group(0)
        if re.search(r'name\s*=\s*["\']%s["\']' % re.escape(name), tag, re.I):
            c = re.search(r'content\s*=\s*"([^"]*)"|content\s*=\s*\'([^\']*)\'', tag, re.I)
            if c:
                vals.append(c.group(1) if c.group(1) is not None else c.group(2))
    return vals


# ----------------------------------------------------------------------------- source checks
def source_checks(html):
    out = []
    if not re.search(r"</html>\s*$", html.strip()[-200:], re.I):
        out.append(("truncated", "source does not end with </html>: the build stopped before writing the whole file", ""))
    text = re.sub(r"<(style|script)\b.*?</\1>", " ", html, flags=re.S | re.I)
    text = re.sub(r"<[^>]+>", " ", text)
    holes = sorted(set(re.findall(r"\{[a-z_][a-z0-9_]{1,30}\}", text)))
    if holes:
        out.append(("placeholder", f"unfilled template placeholder(s) in the text: {', '.join(holes[:6])}", ""))
    return out


# ----------------------------------------------------------------------------- render + preflight
PAGE_MARGINS_JS = """() => {
  const toMm = (v) => { const m = String(v).trim().match(/^(-?[\\d.]+)(mm|cm|in|pt|px)?$/); if (!m) return null;
    const n = parseFloat(m[1]); return { mm: n, cm: n * 10, in: n * 25.4, pt: n / 72 * 25.4, px: n / 96 * 25.4 }[m[2] || 'px']; };
  let found = null;
  const walk = (rules) => { for (const r of rules) {
    if (r.type === CSSRule.PAGE_RULE && !r.selectorText) {
      const s = r.style, sides = ['margin-top', 'margin-right', 'margin-bottom', 'margin-left'].map((k) => s.getPropertyValue(k));
      if (sides.some((x) => x)) found = sides.map((x) => (x ? toMm(x) : null));
    } else if (r.cssRules) { try { walk(r.cssRules); } catch (e) {} } } };
  for (const sh of document.styleSheets) { try { walk(sh.cssRules); } catch (e) {} }
  return found && found.every((x) => x !== null) ? found : null;
}"""



_SHARED = {"browser": None, "pw": None}  # set by do_test: one Chromium reused across fixtures


def render_pdf(src, out_pdf, profile):
    try:
        from playwright.sync_api import sync_playwright
    except ImportError:
        raise SystemExit("docgate: python playwright is not installed (pip install playwright==%s && playwright install chromium)" % PINNED_PLAYWRIGHT)
    page_w_mm = profile["page"]["width_pt"] / MM
    js = PREFLIGHT_JS.read_text()
    if _SHARED["browser"] is not None:
        return _render_in(_SHARED["browser"], src, out_pdf, profile, js, page_w_mm, close_browser=False)
    with sync_playwright() as p:
        return _render_in(p.chromium.launch(), src, out_pdf, profile, js, page_w_mm, close_browser=True)


def _render_in(browser, src, out_pdf, profile, js, page_w_mm, close_browser):
    ctx = None
    if True:
        try:
            ctx = browser.new_context(viewport={"width": 658, "height": 1123})
            page = ctx.new_page()
            failed = []
            page.on("requestfailed", lambda r: failed.append(r.url))
            page.goto(Path(src).resolve().as_uri(), wait_until="load")
            # The document's own @page margins decide its content box; the profile is the fallback.
            margins = page.evaluate(PAGE_MARGINS_JS) or profile["page"]["margin_mm"]
            content_w_px = (page_w_mm - margins[1] - margins[3]) / 25.4 * 96
            page.set_viewport_size({"width": int(round(content_w_px)), "height": 1123})
            page.emulate_media(media="print")
            page.evaluate("document.fonts.ready")
            params = dict(profile["preflight"], contentWidthPx=content_w_px)
            pre = page.evaluate(f"({js})({json.dumps(params)})")
            pre["margins_mm"] = margins
            page.pdf(path=str(out_pdf), prefer_css_page_size=True, print_background=True)
            return pre, browser.version, failed
        finally:
            if ctx is not None:
                try:
                    ctx.close()
                except Exception:
                    pass
            if close_browser:
                browser.close()


# ----------------------------------------------------------------------------- PDF checks
def pdf_pages(pdf):
    code, out, err = run(["pdfinfo", "-box", "-f", "1", "-l", "9999", str(pdf)])
    if code:
        raise SystemExit(f"docgate: pdfinfo failed: {err.strip()}")
    pages = {}
    for line in out.splitlines():
        m = re.match(r"Page\s+(\d+)\s+(size|rot|MediaBox|CropBox|TrimBox):\s+(.*)", line)
        if m:
            pages.setdefault(int(m.group(1)), {})[m.group(2)] = m.group(3).strip()
    return pages


def check_pages(pages, profile):
    out, want = [], profile["page"]
    W, H, tol = want["width_pt"], want["height_pt"], want["tolerance_pt"]
    sizes = set()
    for n, info in sorted(pages.items()):
        m = re.match(r"([\d.]+) x ([\d.]+)", info.get("size", ""))
        w, h = (float(m.group(1)), float(m.group(2))) if m else (0, 0)
        rot = int(float(info.get("rot", "0") or 0))
        sizes.add((round(w), round(h), rot))
        boxes = {k: info.get(k) for k in ("MediaBox", "CropBox", "TrimBox") if info.get(k)}
        if rot % 180:
            out.append(("page-size", f"page {n} is rotated {rot} degrees", f"page {n}"))
        if abs(w - W) > tol or abs(h - H) > tol:
            orient = "landscape" if w > h else "portrait"
            out.append(("page-size", f"page {n} is {w:.0f} x {h:.0f} pt ({orient}); the profile wants {W:.0f} x {H:.0f} pt", f"page {n}"))
        if len(set(boxes.values())) > 1:
            out.append(("page-size", f"page {n} boxes differ: {boxes}", f"page {n}"))
    if len(sizes) > 1:
        out.append(("page-size", f"{len(sizes)} different page sizes or rotations in one document: {sorted(sizes)}", ""))
    return out


def check_fonts(pdf, expect, require_embedded):
    code, out, err = run(["pdffonts", str(pdf)])
    if code:
        return [("fonts", f"pdffonts failed: {err.strip()}", "")], []
    rows = []
    for line in out.splitlines()[2:]:
        parts = line.split()
        if len(parts) < 6:
            continue
        # name type... emb sub uni object ID: emb is the 5th field from the end
        rows.append({"name": parts[0], "emb": parts[-5], "type": " ".join(parts[1:-5])})
    findings = []
    if require_embedded:
        for r in rows:
            if r["emb"] != "yes":
                findings.append(("fonts", f"font not embedded: {r['name']} ({r['type']})", ""))
    names = " ".join(r["name"].split("+")[-1].lower() for r in rows)
    for fam in expect:
        if fam.lower().replace(" ", "") not in names.replace("-", ""):
            findings.append(("fonts", f"expected family {fam} is not in the PDF (found: {', '.join(sorted(set(r['name'].split('+')[-1] for r in rows))) or 'none'}): a webfont failed to load and a fallback printed instead", ""))
    return findings, rows


def rasterize(pdf, tiles_dir, pages):
    """150 dpi page images page-NN.png for `pages` (a list of page numbers). Page ranges run
    as parallel pdftoppm processes; stale images of these pages are removed first, and the
    images of other pages are left alone."""
    tiles_dir.mkdir(parents=True, exist_ok=True)
    want = set(pages)
    for old in tiles_dir.glob("page-*.png"):
        m = re.match(r"page-(\d+)(?:-t\d)?\.png$", old.name)
        if m and int(m.group(1)) in want:
            old.unlink()
    n = max(1, min(len(pages), os.cpu_count() or 1, 8))
    size = -(-len(pages) // n)
    procs = []
    for i in range(0, len(pages), size):
        chunk = pages[i:i + size]
        # contiguous runs only: split a gappy chunk into runs
        runs, start = [], 0
        for k in range(1, len(chunk) + 1):
            if k == len(chunk) or chunk[k] != chunk[k - 1] + 1:
                runs.append((chunk[start], chunk[k - 1]))
                start = k
        for a, b in runs:
            procs.append(subprocess.Popen(["pdftoppm", "-r", str(DPI), "-f", str(a), "-l", str(b), "-png", str(pdf), str(tiles_dir / "page")],
                                          stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True))
    for pr in procs:
        _, err = pr.communicate()
        if pr.returncode:
            raise SystemExit(f"docgate: pdftoppm failed: {err.strip()}")
    norm = []
    for p in sorted(tiles_dir.glob("page-*.png")):
        m = re.match(r"page-(\d+)\.png$", p.name)
        if not m or int(m.group(1)) not in want:
            continue
        n_ = int(m.group(1))
        q = tiles_dir / f"page-{n_:02d}.png"
        if p != q:
            p.rename(q)
        norm.append(q)
    return sorted(norm)


def page_no(path):
    return int(re.search(r"page-(\d+)\.png$", str(path)).group(1))


def measure_pages(pngs, profile, margins=None):
    """Ink extent and coverage per page image (page numbers come from the file names)."""
    from PIL import Image
    m = margins or profile["page"]["margin_mm"]
    thr = profile["fill"]["ink_threshold"]
    metrics = []
    for path in pngs:
        im = Image.open(path).convert("L")
        Wp, Hp = im.size
        top, bottom = int(m[0] / 25.4 * DPI), Hp - int(m[2] / 25.4 * DPI)
        left, right = int(m[3] / 25.4 * DPI), Wp - int(m[1] / 25.4 * DPI)
        box = im.crop((left, top, right, bottom))
        mask = box.point(lambda v: 255 if v < thr else 0)
        bbox = mask.getbbox()
        ch = bottom - top
        extent = (bbox[3] / ch) if bbox else 0.0
        hist = mask.histogram()
        ink = hist[255] / float(box.size[0] * box.size[1])
        metrics.append({"page": page_no(path), "extent": round(extent, 3), "ink": round(ink, 4)})
    return metrics


def write_bands(pngs):
    """Three full-width bands per page with overlap, for reading small type at 150 dpi.
    Opt-in (--bands): they triple the image count and are rarely what a review needs."""
    from PIL import Image
    tiles = []
    for path in pngs:
        im = Image.open(path)
        Wp, Hp = im.size
        band = Hp // 3
        for k in range(3):
            y0 = max(0, k * band - 40)
            y1 = min(Hp, (k + 1) * band + 40)
            tp = path.with_name(f"{path.stem}-t{k + 1}.png")
            im.crop((0, y0, Wp, y1)).save(tp)
            tiles.append(str(tp))
    return tiles


def check_stranded(pdf, margins, profile, only=None):
    """A section heading left at the foot of a page, its content on the next. Read from the
    real PDF's text lines (pdftotext -bbox-layout): a heading is a line at least 1.6x the median
    line height; stranded = in the bottom quarter of the content box, fewer than 3 lines after
    it on that page, and not the last page."""
    code, out, err = run(["pdftotext", "-bbox-layout", str(pdf), "-"])
    if code:
        return []
    pages = []
    for pm in re.finditer(r'<page width="([\d.]+)" height="([\d.]+)">(.*?)</page>', out, re.S):
        lines = []
        for lm in re.finditer(r'<line xMin="[\d.]+" yMin="([\d.]+)" xMax="[\d.]+" yMax="([\d.]+)">(.*?)</line>', pm.group(3), re.S):
            y0, y1 = float(lm.group(1)), float(lm.group(2))
            text = " ".join(re.findall(r">([^<]+)</word>", lm.group(3)))
            lines.append((y0, y1 - y0, text))
        pages.append((float(pm.group(2)), sorted(lines)))
    heights = sorted(h for _, ls in pages for _, h, _ in ls)
    if not heights:
        return []
    median = heights[len(heights) // 2]
    out_f, top_mm, bottom_mm = [], margins[0], margins[2]
    for n, (H, lines) in enumerate(pages[:-1], 1):
        if only is not None and n not in only:
            continue
        top, bottom = top_mm * MM, H - bottom_mm * MM
        for i, (y, h, text) in enumerate(lines):
            if h < 1.6 * median or y < top + (bottom - top) * 0.75:
                continue
            after = [l for l in lines[i + 1:] if y + h * 0.5 < l[0] < bottom]  # the footer lives in the margin
            if len(after) < profile.get("stranded_min_lines", 3):
                out_f.append(("stranded-heading", f"heading \"{text[:50]}\" sits at the foot of page {n} with {len(after)} line(s) under it; its content starts on page {n + 1}", f"page {n}"))
    return out_f


def check_fill(metrics, profile, total=None):
    """Page fill and orphans. `total` is the document's page count, so a partial run still
    knows which page is the last one."""
    out = []
    f = profile["fill"]
    total = total or len(metrics)
    for mt in metrics:
        if mt["page"] < total:
            if mt["extent"] < f["min_final"]:
                out.append(("orphan", f"page {mt['page']} holds only {mt['extent'] * 100:.0f}% of a page before a break: an orphaned fragment", f"page {mt['page']}"))
            elif mt["extent"] < f["min_nonfinal"]:
                out.append(("fill", f"page {mt['page']} ends {mt['extent'] * 100:.0f}% of the way down (calibrated minimum {f['min_nonfinal'] * 100:.0f}%): a half-empty page", f"page {mt['page']}"))
        elif total > 1 and mt["extent"] < f["min_final"]:
            out.append(("orphan", f"last page {mt['page']} holds only {mt['extent'] * 100:.0f}% of a page (minimum {f['min_final'] * 100:.0f}%): an orphaned tail", f"page {mt['page']}"))
    return out


# ----------------------------------------------------------------------------- render command
def check_quality(pdf, pages=None):
    """Relational layout quality (lib/quality.py): card in card, faint frames, big type
    boxed narrow, a smear of gap sizes. Banded from best-in-class reference reports."""
    sys.path.insert(0, str(HERE / "lib"))
    import quality
    out, per_page = [], []
    for r, fs in quality.analyze(Path(pdf), pages):
        m = r.metrics
        per_page.append({"page": r.page, "frames": len([f for f in r.frames if f.lines]),
                         "frame_depth_max": m.get("frame_depth_max"), "gap_levels": m.get("gap_levels"),
                         "frame_contrast_min": m.get("frame_contrast_min")})
        for f in fs:
            out.append((f["rule"], f["detail"], f"page {r.page}"))
    return out, per_page


def do_render(src, out_pdf, profile_name, tiles=None, quiet=False, allow_drift=False, pages=None, bands=False):
    src, out_pdf = Path(src), Path(out_pdf)
    profile = load_profile(profile_name)
    versions = tool_versions()
    if versions.get("playwright") != PINNED_PLAYWRIGHT and not allow_drift:
        raise SystemExit(f"docgate: renderer drift: playwright {versions.get('playwright')} installed, {PINNED_PLAYWRIGHT} pinned. "
                         f"pip install playwright=={PINNED_PLAYWRIGHT}, or pass --allow-renderer-drift (recorded in the receipt).")
    html = src.read_text(encoding="utf-8", errors="replace")
    findings = []  # (rule, msg, where)
    findings += source_checks(html)

    timings = {}
    out_pdf.parent.mkdir(parents=True, exist_ok=True)
    tmp_pdf = out_pdf.with_name(out_pdf.name + ".docgate-tmp")
    with stage(timings, "chromium"):
        pre, chromium, failed_requests = render_pdf(src, tmp_pdf, profile)
    for f in pre["findings"]:
        findings.append((f["rule"], f["msg"], f["el"]))
    for url in failed_requests[:5]:
        findings.append(("fonts" if re.search(r"\.(ttf|otf|woff2?)$", url, re.I) else "asset", f"failed to load {url}", ""))
    os.replace(tmp_pdf, out_pdf)  # the PDF only appears once it is whole

    with stage(timings, "pdf_checks"):
        page_info = pdf_pages(out_pdf)
        total = len(page_info)
        sel = parse_pages(pages, total) if pages else list(range(1, total + 1))
        partial = len(sel) < total
        findings += check_pages(page_info, profile)  # document-wide and cheap: always on every page
        expect = [s.strip() for v in meta_values(html, "docgate-fonts") for s in v.split(",") if s.strip()] or profile["fonts"]["expect"]
        font_findings, font_rows = check_fonts(out_pdf, expect, profile["fonts"]["require_embedded"])
        findings += font_findings

    digest = sha256(out_pdf)
    tiles_dir = Path(tiles) if tiles else Path(tempfile.gettempdir()) / "docgate" / digest[:12]
    with stage(timings, "raster"):
        pngs = rasterize(out_pdf, tiles_dir, sel)
    with stage(timings, "fill"):
        metrics = measure_pages(pngs, profile, pre.get("margins_mm"))
        findings += check_fill(metrics, profile, total)
        findings += check_stranded(out_pdf, pre.get("margins_mm") or profile["page"]["margin_mm"], profile["fill"], set(sel))
    tile_paths = []
    if bands:
        with stage(timings, "bands"):
            tile_paths = write_bands(pngs)
    with stage(timings, "quality"):
        q_findings, q_pages = check_quality(out_pdf, sel)
    findings += q_findings
    if partial:
        findings.append(("partial", f"partial render: page rules and quality ran on pages {fmt_pages(sel)} of {total} only. "
                                    f"Iteration only: a deliverable needs a full `docgate render` without --pages", ""))

    # waivers
    waivers = {}
    for v in meta_values(html, "docgate-waive"):
        rule, _, reason = v.partition(":")
        if len(reason.strip()) >= 15:
            waivers[rule.strip()] = reason.strip()
    levels = dict(profile["levels"], partial="fail")
    results = []
    for rule, msg, where in findings:
        level = levels.get(rule, "warn")
        if level == "fail" and rule in waivers:
            level = "waived"
        results.append({"rule": rule, "level": level, "msg": msg, "where": where})
    blocking = [r for r in results if r["level"] == "fail"]

    receipt = {
        "docgate": VERSION,
        "pdf": str(out_pdf.resolve()),
        "pdf_sha256": digest,
        "source": str(src.resolve()),
        "source_sha256": sha256(src),
        "profile": profile["name"],
        "created_at": dt.datetime.now(dt.timezone.utc).isoformat(timespec="seconds"),
        "tools": dict(versions, chromium=chromium, renderer_drift=versions.get("playwright") != PINNED_PLAYWRIGHT),
        "pass": not blocking,
        "counts": {lvl: sum(1 for r in results if r["level"] == lvl) for lvl in ("fail", "warn", "waived")},
        "partial": partial,
        "pages_checked": sel,
        "timings": dict(timings, total=round(sum(timings.values()), 2)),
        "pages": metrics,
        "page_count": total,
        "fonts": sorted(set(r["name"].split("+")[-1] for r in font_rows)),
        "preflight_metrics": pre["metrics"],
        "quality": q_pages,
        "waivers": waivers,
        "results": results,
        "tiles_dir": str(tiles_dir),
        "bands": bands,
        "pages_png": [str(p) for p in pngs],
        "tiles": tile_paths,
    }
    Path(str(out_pdf) + ".docgate.json").write_text(json.dumps(receipt, indent=1, ensure_ascii=False))
    if not quiet:
        print_summary(receipt)
    return receipt


QUALITY_RULES = {"nested-frame", "faint-frame", "large-narrow", "gap-levels", "gap-scale", "frame-heavy"}


def print_summary(r):
    c = r["counts"]
    print(f"docgate {'PASS' if r['pass'] else 'FAIL'}  {r['pdf']}")
    part = f", PARTIAL (pages {fmt_pages(r['pages_checked'])}: iteration only, never a deliverable)" if r.get("partial") else ""
    print(f"  {r['page_count']} pages{part}, profile {r['profile']}, {c['fail']} blocking, {c['warn']} warnings, {c['waived']} waived")
    print("  page extent: " + "  ".join(f"p{m['page']} {m['extent'] * 100:.0f}%" for m in r["pages"]))
    by = {}
    for x in r["results"]:
        by.setdefault((x["level"], x["rule"]), []).append(x)
    for (level, rule), xs in sorted(by.items(), key=lambda k: ({"fail": 0, "waived": 1, "warn": 2}[k[0][0]], k[0][1])):
        print(f"  {level.upper():6} {rule:12} x{len(xs)}  {xs[0]['msg']}" + (f"  [{xs[0]['where']}]" if xs[0]["where"] else ""))
    qbad = sorted({x["where"].split()[-1] for x in r["results"] if x["level"] in ("fail", "warn") and x["rule"] in QUALITY_RULES and x["where"]}, key=int)
    if qbad:
        print(f"  why a quality finding fires: docgate quality {r['pdf']} --pages {','.join(qbad)} --explain")
    print(f"  receipt {r['pdf']}.docgate.json  (sha256 {r['pdf_sha256'][:12]})")
    t = r.get("timings")
    if t:
        print("  timings: " + "  ".join(f"{k} {v:.1f}s" for k, v in t.items()))
    print(f"  page images{' + bands' if r.get('bands') else ''} for self-review: {r['tiles_dir']}")


# ----------------------------------------------------------------------------- check command
def do_check(pdf):
    pdf = Path(pdf)
    rp = Path(str(pdf) + ".docgate.json")
    if not pdf.is_file():
        print(f"docgate: no such PDF {pdf}")
        return 2
    if not rp.is_file():
        print(f"docgate: NO RECEIPT for {pdf}. Produce it with: docgate render <source.html> {pdf}")
        return 1
    r = json.loads(rp.read_text())
    if r.get("pdf_sha256") != sha256(pdf):
        print(f"docgate: STALE RECEIPT: {pdf} changed after docgate rendered it. Re-render with docgate.")
        return 1
    print_summary(r)
    if r.get("partial"):
        print("docgate: this receipt is PARTIAL (render with --pages): it can never pass. Run a full `docgate render` for the deliverable.")
    return 0 if r.get("pass") else 1


# ----------------------------------------------------------------------------- test command
def materialise(entry, base, workdir):
    src = entry["source"]
    if "file" in src:
        return (base / src["file"]).resolve()
    if "git" in src:
        repo = Path(os.path.expanduser(src["git"]))
        if not repo.is_absolute():
            repo = (base / repo).resolve()
        code, out, err = run(["git", "-C", str(repo), "show", f"{src['commit']}:{src['path']}"])
        if code:
            raise RuntimeError(f"git show failed: {err.strip()}")
        dest = workdir / f"{entry['id']}.html"
        dest.write_text(out, encoding="utf-8")
        return dest
    if "build" in src:
        # a builder script that writes the document: ["python3", "script.py", "{out}"]
        dest = workdir / f"{entry['id']}.html"
        cmd = [c.replace("{out}", str(dest)) for c in src["build"]]
        cmd = [str((base / c).resolve()) if c.endswith(".py") and not os.path.isabs(c) else c for c in cmd]
        code, out, err = run(cmd)
        if code or not dest.is_file():
            raise RuntimeError(f"build failed: {(err or out).strip()[-300:]}")
        return dest
    raise RuntimeError("fixture source needs 'file', 'git' or 'build'")


def do_test(manifests, only=None, verbose=False):
    rows, ok_all = [], True
    work = Path(tempfile.mkdtemp(prefix="docgate-test-"))
    from playwright.sync_api import sync_playwright
    _SHARED["pw"] = sync_playwright().start()
    _SHARED["browser"] = _SHARED["pw"].chromium.launch()
    try:
        return _do_test(manifests, only, verbose, rows, ok_all, work)
    finally:
        try:
            _SHARED["browser"].close()
        except Exception:
            pass
        _SHARED["browser"] = None
        _SHARED["pw"].stop()


def _do_test(manifests, only, verbose, rows, ok_all, work):
    for mpath in manifests:
        mpath = Path(os.path.expanduser(mpath)).resolve()
        manifest = json.loads(mpath.read_text())
        for e in manifest["fixtures"]:
            if only and not re.search(only, e["id"]):
                continue
            try:
                src = materialise(e, mpath.parent, work)
                rec = do_render(src, work / f"{e['id']}.pdf", e.get("profile", manifest.get("profile", "a4-report")),
                                tiles=work / f"{e['id']}-tiles", quiet=True)
            except Exception as exc:  # a crash in one fixture is a failed fixture, not a dead run
                rows.append((e["id"], False, f"could not run: {exc}", ""))
                ok_all = False
                if not _SHARED["browser"].is_connected():  # the browser died: start a fresh one for the rest
                    _SHARED["browser"] = _SHARED["pw"].chromium.launch()
                continue
            fails = {r["rule"] for r in rec["results"] if r["level"] == "fail"}
            seen = {r["rule"] for r in rec["results"]}
            exp = e["expect"]
            problems = []
            if exp.get("pass") is True and fails:
                problems.append(f"should pass, blocked by {sorted(fails)}")
            if exp.get("pass") is False and not fails:
                problems.append("should be blocked, passed")
            for rule in exp.get("fail", []):
                if rule not in fails:
                    problems.append(f"missed blocking {rule}")
            for rule in exp.get("warn", []):
                if rule not in seen:
                    problems.append(f"missed warning {rule}")
            for rule in exp.get("not", []):
                if rule in seen:
                    problems.append(f"false {rule}")
            ok = not problems
            ok_all &= ok
            got = ", ".join(f"{k}x{v}" for k, v in sorted(
                {r["rule"]: sum(1 for x in rec["results"] if x["rule"] == r["rule"] and x["level"] == "fail") for r in rec["results"] if r["level"] == "fail"}.items()))
            warns = ", ".join(sorted({r["rule"] for r in rec["results"] if r["level"] == "warn"}))
            rows.append((e["id"], ok, "; ".join(problems) or e.get("note", ""), f"blocks [{got}] warns [{warns}]"))
            if verbose:
                print_summary(rec)
    w = max(len(r[0]) for r in rows) if rows else 10
    for rid, ok, msg, got in rows:
        print(f"{'ok  ' if ok else 'FAIL'}  {rid:<{w}}  {got}")
        if msg:
            print(f"      {'':<{w}}  {msg}")
    print(f"\n{sum(1 for r in rows if r[1])}/{len(rows)} fixtures behave as expected")
    shutil.rmtree(work, ignore_errors=True)
    return 0 if ok_all else 1


# ----------------------------------------------------------------------------- pair command
def do_pair(a, b, outdir, dpi=100, labels=("before", "after")):
    """Matched page pairs, side by side, same scale: for golden-reference comparison and
    before/after evidence. Writes pair-NN.png per page index."""
    from PIL import Image, ImageDraw
    outdir = Path(outdir)
    outdir.mkdir(parents=True, exist_ok=True)
    sets = []
    for pdf, tag in ((a, "a"), (b, "b")):
        d = outdir / f"_{tag}"
        d.mkdir(exist_ok=True)
        for old in d.glob("*.png"):
            old.unlink()
        code, _, err = run(["pdftoppm", "-r", str(dpi), "-png", str(pdf), str(d / "p")])
        if code:
            raise SystemExit(f"docgate: pdftoppm failed on {pdf}: {err.strip()}")
        sets.append(sorted(d.glob("p-*.png")))
    n = max(len(sets[0]), len(sets[1]))
    written = []
    for i in range(n):
        ims = [Image.open(s[i]).convert("RGB") if i < len(s) else None for s in sets]
        w = max(im.size[0] for im in ims if im)
        h = max(im.size[1] for im in ims if im)
        gutter, head = 24, 28
        canvas = Image.new("RGB", (2 * w + 3 * gutter, h + head + gutter), (232, 230, 225))
        dr = ImageDraw.Draw(canvas)
        for k, im in enumerate(ims):
            x = gutter + k * (w + gutter)
            dr.text((x, 8), f"{labels[k]}  ·  page {i + 1}" + ("" if im else "  (no such page)"), fill=(28, 23, 27))
            if im:
                canvas.paste(im, (x, head))
        p = outdir / f"pair-{i + 1:02d}.png"
        canvas.save(p)
        written.append(p)
    print(f"{n} page pairs ({len(sets[0])} vs {len(sets[1])} pages) in {outdir}")
    return 0


# ----------------------------------------------------------------------------- sheet command
def do_sheet(src, out, pages=None, cols=3, per=6, width=1560, labels=True):
    """Contact sheets: `per` pages to an image, `cols` across, `width` px wide (about the size an
    LLM reads without downscaling), each cell labelled with its page number. `src` is a PDF or a
    folder of page-NN.png images (a render's tiles_dir). Writes out.png, or out-1.png, out-2.png
    when the pages do not fit one sheet. For layout and rhythm across pages; read a page image
    itself for type."""
    from PIL import Image, ImageDraw
    src, out = Path(src), Path(out)
    out.parent.mkdir(parents=True, exist_ok=True)
    gutter, head = 14, 18
    cell_w = (width - (cols + 1) * gutter) // cols
    if src.is_dir():
        files = {page_no(f): f for f in src.glob("page-*.png") if re.search(r"page-\d+\.png$", f.name)}
        if not files:
            raise SystemExit(f"docgate sheet: no page-NN.png in {src}")
        total = max(files)
        sel = parse_pages(pages, total) if pages else sorted(files)
        sel = [n for n in sel if n in files]
        imgs = [(n, Image.open(files[n]).convert("RGB")) for n in sel]
    else:
        total = len(pdf_pages(src))
        sel = parse_pages(pages, total) if pages else list(range(1, total + 1))
        with tempfile.TemporaryDirectory() as td:
            dpi = max(30, int(cell_w / 8.27))  # cell width in inches of an A4 page
            procs = []
            for n in sel:
                procs.append(subprocess.Popen(["pdftoppm", "-r", str(dpi), "-f", str(n), "-l", str(n), "-png", "-singlefile", str(src), f"{td}/p{n}"],
                                              stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True))
            for pr in procs:
                _, err = pr.communicate()
                if pr.returncode:
                    raise SystemExit(f"docgate sheet: pdftoppm failed: {err.strip()}")
            imgs = [(n, Image.open(f"{td}/p{n}.png").convert("RGB")) for n in sel]
            for _, im in imgs:
                im.load()
    if not imgs:
        raise SystemExit("docgate sheet: no pages to draw")
    written = []
    chunks = [imgs[i:i + per] for i in range(0, len(imgs), per)]
    for ci, chunk in enumerate(chunks, 1):
        cells = []
        for n, im in chunk:
            h = round(im.size[1] * cell_w / im.size[0])
            cells.append((n, im.resize((cell_w, h), Image.LANCZOS)))
        rows = [cells[i:i + cols] for i in range(0, len(cells), cols)]
        row_h = [max(c[1].size[1] for c in row) + (head if labels else 0) for row in rows]
        canvas = Image.new("RGB", (width, gutter + sum(h + gutter for h in row_h)), (232, 230, 225))
        dr = ImageDraw.Draw(canvas)
        y = gutter
        for row, rh in zip(rows, row_h):
            for k, (n, im) in enumerate(row):
                x = gutter + k * (cell_w + gutter)
                if labels:
                    dr.text((x, y + 2), f"p{n}", fill=(28, 23, 27))
                canvas.paste(im, (x, y + (head if labels else 0)))
                dr.rectangle((x - 1, y + (head if labels else 0) - 1, x + im.size[0], y + (head if labels else 0) + im.size[1]), outline=(190, 186, 178))
            y += rh + gutter
        path = out if len(chunks) == 1 else out.with_name(f"{out.stem}-{ci}{out.suffix or '.png'}")
        canvas.save(path)
        written.append((path, [n for n, _ in chunk]))
    for path, ns in written:
        print(f"{path}  pages {fmt_pages(ns)}  {Image.open(path).size[0]}x{Image.open(path).size[1]}")
    return 0


# ----------------------------------------------------------------------------- gallery command
def do_gallery(outdir, profile_name="a4-report"):
    """Render every component alone in each state (assets/gallery.py) and gate each one.
    A component may be used in a deliverable only while all its states pass."""
    outdir = Path(outdir)
    outdir.mkdir(parents=True, exist_ok=True)
    html, pdf = outdir / "gallery.html", outdir / "gallery.pdf"
    code, out, err = run([sys.executable, str(HERE / "assets" / "gallery.py"), str(html)])
    if code:
        print(f"docgate gallery: build failed: {err.strip()[-400:]}")
        return 2
    rec = do_render(html, pdf, profile_name, tiles=outdir / "tiles", quiet=True)
    owner = {}  # page -> (component, state), from the caption line on each state's first page
    cur = None
    for n in range(1, rec["page_count"] + 1):
        _, txt, _ = run(["pdftotext", "-f", str(n), "-l", str(n), "-layout", str(pdf), "-"])
        m = re.search(r"GALLERY (\S+) · ([^\n]+)", txt)
        if m:
            cur = (m.group(1).lower(), m.group(2).strip().lower())
        owner[n] = cur
    rows = {}
    for c, s in owner.values():
        rows.setdefault((c, s), [])
    doc_level = []
    for r in rec["results"]:
        if r["level"] not in ("fail", "warn"):
            continue
        pm = re.search(r"page (\d+)", r["where"] or "")
        if pm and owner.get(int(pm.group(1))):
            rows[owner[int(pm.group(1))]].append(r)
        else:
            doc_level.append(r)
    bad = 0
    print(f"docgate gallery  {pdf}")
    for (c, s), rs in rows.items():
        fails = sorted({r["rule"] for r in rs if r["level"] == "fail"})
        warns = sorted({r["rule"] for r in rs if r["level"] == "warn"})
        bad += bool(fails)
        print(f"  {'FAIL' if fails else 'ok  '}  {c:10} {s:20} {' '.join(fails)}" + (f"  (warn: {' '.join(warns)})" if warns else ""))
    for r in doc_level:
        print(f"  {r['level'].upper():5} (whole gallery) {r['rule']}: {r['msg'][:110]}")
    print(f"  {len(rows) - bad}/{len(rows)} component states pass. Tiles: {outdir / 'tiles'}")
    return 1 if bad else 0


# ----------------------------------------------------------------------------- main
def main():
    ap = argparse.ArgumentParser(prog="docgate", description=__doc__.split("\n\n")[0])
    sub = ap.add_subparsers(dest="cmd", required=True)
    r = sub.add_parser("render")
    r.add_argument("src")
    r.add_argument("out")
    r.add_argument("--profile", default="a4-report")
    r.add_argument("--tiles", help="folder for the page images (default: a temp folder keyed by the PDF hash)")
    r.add_argument("--pages", help="iteration only: page rules, images and quality on these pages (3, 10-12, 1,4,8-9); the receipt is partial and never passes")
    r.add_argument("--bands", action="store_true", help="also write three band tiles per page (page-NN-tK.png); off by default")
    r.add_argument("--allow-renderer-drift", action="store_true")
    c = sub.add_parser("check")
    c.add_argument("pdf")
    t = sub.add_parser("test")
    t.add_argument("--manifest", action="append")
    t.add_argument("--only")
    t.add_argument("-v", "--verbose", action="store_true")
    pr = sub.add_parser("pair")
    pr.add_argument("a")
    pr.add_argument("b")
    pr.add_argument("outdir")
    pr.add_argument("--dpi", type=int, default=100)
    pr.add_argument("--labels", default="before,after")
    q = sub.add_parser("quality", help="measure layout quality of any PDF (no receipt), e.g. a reference report")
    q.add_argument("pdf")
    q.add_argument("--pages", help="3, 10-12 or 1,4,8-9")
    q.add_argument("-v", "--verbose", action="store_true")
    q.add_argument("--explain", action="store_true", help="for each finding, the lines, gaps or frames that cause it")
    sh = sub.add_parser("sheet", help="contact sheet: several pages per image, sized for an LLM to read")
    sh.add_argument("src", help="a PDF, or a folder of page-NN.png (a render's tiles_dir)")
    sh.add_argument("--out", required=True)
    sh.add_argument("--pages")
    sh.add_argument("--cols", type=int, default=3)
    sh.add_argument("--per", type=int, default=6, help="pages per image")
    sh.add_argument("--width", type=int, default=1560, help="image width in px")
    pl = sub.add_parser("plan", help="gate a layout plan (grid, type and gap scales, measure, frames, references) before building")
    pl.add_argument("plan")
    g = sub.add_parser("gallery", help="render every report_kit component alone in each state and gate each one")
    g.add_argument("--out", default=str(Path(tempfile.gettempdir()) / "docgate-gallery"))
    sub.add_parser("version")
    a = ap.parse_args()
    if a.cmd == "pair":
        return do_pair(a.a, a.b, a.outdir, a.dpi, tuple(a.labels.split(",", 1)))
    if a.cmd == "render":
        rec = do_render(a.src, a.out, a.profile, a.tiles, allow_drift=a.allow_renderer_drift, pages=a.pages, bands=a.bands)
        return 0 if rec["pass"] else 1
    if a.cmd == "sheet":
        return do_sheet(a.src, a.out, a.pages, a.cols, a.per, a.width)
    if a.cmd == "check":
        return do_check(a.pdf)
    if a.cmd == "test":
        return do_test(a.manifest or [str(DEFAULT_MANIFEST)], a.only, a.verbose)
    if a.cmd == "plan":
        sys.path.insert(0, str(HERE / "lib"))
        import plan as plan_mod
        return plan_mod.run(a.plan)
    if a.cmd == "gallery":
        return do_gallery(a.out)
    if a.cmd == "quality":
        sys.path.insert(0, str(HERE / "lib"))
        import quality
        pages = parse_pages(a.pages, quality.page_count(Path(a.pdf))) if a.pages else None
        bad = 0
        for r, fs in quality.analyze(Path(a.pdf), pages):
            if a.explain:
                for f in fs:
                    bad += f["severity"] == "fail"
                    print(f"  {f['severity'].upper()}")
                    print("\n".join(quality.explain(r, [f])))
            else:
                for f in fs:
                    bad += f["severity"] == "fail"
                    print(f"  p{r.page:02d} {f['severity'].upper():5s} {f['rule']:13s} {f['detail']}")
            if a.verbose:
                mm = {k: v for k, v in r.metrics.items() if k not in ("heading_ratios", "gap_list", "gap_pairs")}
                print(f"  p{r.page:02d} metrics " + json.dumps(mm, ensure_ascii=False, default=str))
        print(f"docgate quality: {'FAIL' if bad else 'PASS'} ({bad} blocking)")
        return 1 if bad else 0
    if a.cmd == "version":
        print(json.dumps(tool_versions()))
        return 0


if __name__ == "__main__":
    sys.exit(main())
